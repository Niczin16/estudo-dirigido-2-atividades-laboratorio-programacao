<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>

<GridPane hgap="10.0" vgap="12.0" styleClass="formulario" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="FormularioCadastroController">
    <columnConstraints>
        <ColumnConstraints minWidth="150.0" />
        <ColumnConstraints minWidth="180.0" />
    </columnConstraints>
    <padding>
        <Insets bottom="25.0" left="15.0" right="30.0" top="15.0" />
    </padding>
    <children>
        <Label text="Informe Cpf:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtCpf" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Nome:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtNome" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Endere&#231;o:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtEndereco" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <ComboBox fx:id="cmbEstado" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Cargo:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <ComboBox fx:id="cmbCargo" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <Button fx:id="btnImprimir" maxWidth="1.7976931348623157E308" text="Imprimir Dados" GridPane.columnIndex="0" GridPane.rowIndex="5" />
    </children>
</GridPane>
